# Copy to /etc/healthhub.env (mode 600, owned by root). deploy.sh creates it on first run.
# Code people need to create an account. Share it only with your group.
HT_INVITE_CODE=change-me
# Optional: lets a CI build upload new APKs to /api/app/upload.
#HT_UPLOAD_TOKEN=
# Optional: read-only GitHub token (contents:read on the app repo). With it the server checks
# the latest release every 15 minutes and offers newer APKs to the app.
#HT_GITHUB_TOKEN=
#HT_GITHUB_REPO=merlinlcb/HealthTracker
# Optional: log every request.
#HT_ACCESS_LOG=1
